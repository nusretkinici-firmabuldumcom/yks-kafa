          ]
        }
      },
      "id": "get-session-data",
      "name": "Oturum Verisini Al",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 120]
    },
    {
      "parameters": {
        "jsCode": "const sessions = $input.first().json;\nif (!sessions || sessions.length === 0) {\n  throw new Error('OTURUM_BULUNAMADI');\n}\nconst session = sessions[0];\n\nconst planAy = session.plan === 'premium_yillik' ? 12 : 6;\nconst bitis = new Date();\nbitis.setMonth(bitis.getMonth() + planAy);\n\nconst odemeDetay = $('Ödeme Sonucunu Kontrol Et').first().json;\n\nreturn [{ json: {\n  kullanici_id: session.kullanici_id,\n  email: session.email,\n  plan: session.plan,\n  tutar: odedeDetay.paidPrice || session.tutar,\n  paymentId: odedeDetay.paymentId,\n  abonelik_bitis: bitis.toISOString(),\n  onay_tarihi: new Date().toISOString()\n}}];\n\nfunction odedeDetay() {} // scope fix\n"
      },
      "id": "build-activation",
      "name": "Aktivasyon Verisi Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 120],
