    {
      "parameters": {
        "httpMethod": "POST",
        "path": "iyzico-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-iyzico-notif",
      "name": "Webhook - iyzico Bildirim",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 560],
      "notes": "iyzico Merchant Portal > Settings > Merchant Notifications'a bu URL'i ekle.\nPOST /webhook/iyzico-webhook\nBody: { paymentId, status, iyziEventType, token, paymentConversationId, merchantId, iyziReferenceCode }"
    },
    {
      "parameters": {
        "jsCode": "// iyzico X-IYZ-SIGNATURE-V3 doğrulama\nconst headers = $input.first().json.headers;\nconst body = $input.first().json.body;\nconst signatureV3 = headers['x-iyz-signature-v3'] || headers['X-Iyz-Signature-V3'];\n\nconst secretKey = $env.IYZICO_SECRET_KEY;\n\nif (signatureV3) {\n  const crypto = require('crypto');\n  // HPP format: secretKey + iyziEventType + iyziPaymentId + token + paymentConversationId + status\n  const key = secretKey + body.iyziEventType + body.iyziPaymentId + (body.token || '') + (body.paymentConversationId || '') + body.status;\n  const computed = crypto.createHmac('sha256', secretKey).update(key).digest('hex');\n  \n  if (computed !== signatureV3) {\n    throw new Error('WEBHOOK_IMZA_GECERSIZ: İmza doğrulaması başarısız');\n  }\n}\n\nreturn [{ json: {\n  paymentId: body.paymentId || body.iyziPaymentId,\n  status: body.status,\n  iyziEventType: body.iyziEventType,\n  token: body.token,\n  conversationId: body.paymentConversationId,\n  merchantId: body.merchantId,\n  imzaDogrulandi: !!signatureV3\n}}];"
      },
      "id": "verify-webhook-signature",
