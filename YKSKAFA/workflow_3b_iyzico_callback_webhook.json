      "id": "webhook-callback",
      "name": "Webhook - iyzico Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 200],
      "notes": "iyzico bu URL'i callbackUrl olarak çağırır (kullanıcı ödeme yaptıktan sonra).\nPOST /webhook/iyzico-callback\nBody: { token, status, paymentId, conversationId, mdStatus? }"
    },
    {
      "parameters": {
        "jsCode": "// iyzico callback'ten gelen token ile ödeme sonucunu sorgula\nconst body = $input.first().json.body;\nconst token = body.token;\nconst status = body.status;\n\nif (!token) throw new Error('TOKEN_EKSIK');\n\n// Callback'te status SUCCESS ise ödemeyi doğrula\nconst apiKey    = $env.IYZICO_API_KEY;\nconst secretKey = $env.IYZICO_SECRET_KEY;\nconst randomKey = new Date().getTime().toString() + '987654321';\nconst uriPath   = '/payment/iyzipos/checkoutform/auth/ecom/detail';\n\nconst reqBody = {\n  locale: 'tr',\n  conversationId: body.conversationId || 'retrieve-' + Date.now(),\n  token: token\n};\nconst bodyStr = JSON.stringify(reqBody);\nconst payload = randomKey + uriPath + bodyStr;\n\nconst crypto = require('crypto');\nconst signature = crypto.createHmac('sha256', secretKey).update(payload).digest('hex');\nconst authStr = 'apiKey:' + apiKey + '&randomKey:' + randomKey + '&signature:' + signature;\nconst base64Auth = Buffer.from(authStr).toString('base64');\n\nreturn [{ json: {\n  token,\n  callbackStatus: status,\n  authHeader: 'IYZWSv2 ' + base64Auth,\n  bodyStr,\n  conversationId: body.conversationId\n}}];"
      },
      "id": "prepare-retrieve",
      "name": "Retrieve İsteği Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 200]
